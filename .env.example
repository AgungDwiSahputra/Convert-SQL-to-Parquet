# Kredensial koneksi SQL Server (JANGAN commit file ini ke Git — sudah masuk .gitignore)
SQLSERVER_HOST=HOST
SQLSERVER_DB=NAME_DB
SQLSERVER_UID=USERNAME
SQLSERVER_PWD=PASSWORD

# --- AWS S3 (upload otomatis hasil .parquet) ---
AWS_ACCESS_KEY_ID=KEY_ID
AWS_SECRET_ACCESS_KEY=SECRET_KEY
AWS_REGION=REGION
S3_BUCKET_NAME=BUCKET_NAME
# Segmen paling luar S3 key (di atas layer). Kosong = layer langsung di root bucket.
# Harus SAMA dengan S3_PREFIX di jobs.py -- migrate_jobs.py menolak kalau beda.
S3_PREFIX=

# --- Database daftar job (opsional; default jobs.db di folder proyek) ---
# JOBS_DB=D:\path\ke\jobs.db

# --- Web UI (webapp/) ---
# Base URL SSO portal (endpoint /api/auth/gettoken & /api/cor/user ada di bawahnya)
SSO_BASE_URL=https://sso.example.com/portalpage
# Lama session login (jam)
SESSION_HOURS=8
# true kalau Web UI diakses lewat HTTPS
COOKIE_SECURE=false
# Alamat Web UI (untuk link di email notifikasi)
APP_BASE_URL=http://nama-server:8000

# --- Email notifikasi (SMTP) -- isi sendiri di server, JANGAN commit ---
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=akun.pengirim@example.com
SMTP_PASSWORD=PASSWORD
# Harus SAMA dengan SMTP_USER (boleh 'Nama <alamat>'), atau kosongkan = pakai SMTP_USER.
# Alamat lain biasanya tetap diterima server (tercatat "Terkirim") lalu dibuang diam-diam.
SMTP_FROM=akun.pengirim@example.com
# Nama pengirim yang terlihat di kotak masuk (opsional; kosong = "Monitoring Parquet Exporter")
SMTP_FROM_NAME=
# starttls | ssl | none  (none = tanpa enkripsi, sesuaikan dengan setelan mail server)
SMTP_SECURITY=starttls
# Nama domain klien saat EHLO (opsional)
SMTP_LOCAL_HOSTNAME=

# --- Folder, ekspor ad-hoc, log & pemeliharaan (opsional; default relatif ke folder proyek) ---
# OUTPUT_DIR=D:\path\ke\output       (file .parquet lokal)
# LOG_DIR=D:\path\ke\logs            (log exporter_*.log & worker_*.log)
# RUN_LOG_DIR=D:\path\ke\logs\runs   (WAJIB beda per database, mis. saat memakai salinan jobs.db untuk uji)
# ADHOC_MAX_ROWS=500000
# BACKUP_DIR=D:\path\ke\backups
# BACKUP_KEEP=14
# LOG_RETENTION_DAYS=90
